# Select the free email provider, or use "sms" for Twilio.
OTP_PROVIDER = "email"

# Copy these keys into Streamlit Cloud Manage app -> Settings -> Secrets.
# Do not commit real values to this file.
TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "replace-with-your-auth-token"
TWILIO_VERIFY_SERVICE_SID = "VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional free email OTP mode. Use a Gmail app password or another SMTP account.
# When Twilio values are absent, these values enable email verification.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USERNAME = "your-email@gmail.com"
SMTP_PASSWORD = "your-app-password"
OTP_FROM_EMAIL = "your-email@gmail.com"
SMTP_USE_TLS = "true"